// TEMPLATE — launched via the `ide` shell function (~/.zshrc). The function
// substitutes the target directory and its basename into the two placeholders on
// the tab line below (directory name and directory cwd) before running zellij, so
// the panes start exactly in the requested directory. Do not invoke this file
// directly; the placeholders are unresolved otherwise.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="__IDE_NAME__" cwd="__IDE_DIR__" {
        pane split_direction="vertical" {
            // Left 2/3: yazi file browser (swaps to helix when opening a file).
            // Runs inside a shell so quitting yazi leaves a normal prompt here
            // instead of zellij's "press ENTER to re-run" dead state.
            pane size="67%" {
                command "zsh"
                args "-lc" "yazi; exec zsh"
            }
            // Right 1/3: pi coding agent. Runs inside a shell so that quitting pi
            // (Ctrl+C twice or /quit) drops you to a normal prompt in this pane —
            // launch opencode, another tool, or just use the terminal from there.
            pane size="33%" {
                command "zsh"
                args "-lc" "pi; exec zsh"
            }
        }
    }
}
