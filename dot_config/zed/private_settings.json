// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto"
      },
      "type": "registry"
    }
  },
  "semantic_tokens": "combined",
  "icon_theme": "Monospace Icon Theme - Dark",
  "vim_mode": true,
  "ssh_connections": [
    {
      "host": "cuda-dev.us-central1-a.omscs-gpu",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/siddharthkapoor/cs7295-gpu-hardware-and-software"
          ]
        }
      ]
    }
  ],
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left",
    "hide_gitignore": false,
    "hide_hidden": false,
  },
  "context_servers": {
    "terraform-context-server": {
      "enabled": true,
      "settings": {},
    },
  },
  "edit_predictions": {
    "mode": "eager",
  },
  "agent": {
    "terminal_init_command": "",
    "dock": "right",
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash-lite",
    },
    "favorite_models": [],
    "single_file_review": false,
    "model_parameters": [],
  },
  "lsp": {
    "spec": {
      "binary": {
        "path": "/Users/siddharthkapoor/.local/bin/spec",
        "arguments": ["lsp", "--stdio"],
      },
    },
  },
  "languages": {
    "Spec": {
      "show_edit_predictions": false,
    },
    "Svelte": {
      "inlay_hints": {
        "enabled": true,
      },
    },
    "Markdown": {
      "tab_size": 2,
      "format_on_save": "on",
      "language_servers": ["spec", "..."],
    },
    "Just": {
      "indent_guides": {
        "coloring": "fixed",
        "background_coloring": "disabled",
      },
    },
  },
  "diagnostics": {
    "inline": {
      "enabled": false,
    },
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "terminal": {
    "dock": "right",
    "font_family": "Menlo",
  },
  "minimap": {
    "show": "never",
  },
  "wrap_guides": [80, 120],
  "soft_wrap": "bounded",
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Vercel Dark",
  },
}
