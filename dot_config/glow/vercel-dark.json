{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#EDEDED",
    "margin": 0
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#A1A1A1"
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#52A8FF",
    "bold": true
  },
  "h1": {
    "prefix": "# "
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### "
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#676767",
    "format": "\n────────\n"
  },
  "item": {
    "block_prefix": "• ",
    "color": "#52A8FF"
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#52A8FF"
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#52A8FF",
    "underline": true
  },
  "link_text": {
    "color": "#52A8FF"
  },
  "image": {
    "color": "#52A8FF",
    "underline": true
  },
  "image_text": {
    "color": "#52A8FF",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#00AC3A",
    "background_color": "#1A1A1A"
  },
  "code_block": {
    "color": "#EDEDED",
    "margin": 0,
    "chroma": {
      "text": { "color": "#EDEDED" },
      "error": { "color": "#EDEDED", "background_color": "#F32E40" },
      "comment": { "color": "#A1A1A1", "italic": true },
      "comment_preproc": { "color": "#8B5CF6" },
      "keyword": { "color": "#8B5CF6" },
      "keyword_reserved": { "color": "#8B5CF6" },
      "keyword_namespace": { "color": "#8B5CF6" },
      "keyword_type": { "color": "#EDEDED" },
      "operator": { "color": "#EDEDED" },
      "punctuation": { "color": "#EDEDED" },
      "name": { "color": "#EDEDED" },
      "name_builtin": { "color": "#EDEDED" },
      "name_tag": { "color": "#F32E40" },
      "name_attribute": { "color": "#00AA95" },
      "name_class": { "color": "#EDEDED" },
      "name_constant": { "color": "#F59E0B" },
      "name_decorator": { "color": "#00AA95" },
      "name_exception": { "color": "#EDEDED" },
      "name_function": { "color": "#52A8FF" },
      "name_other": { "color": "#EDEDED" },
      "literal": { "color": "#EDEDED" },
      "literal_number": { "color": "#F59E0B" },
      "literal_date": { "color": "#F59E0B" },
      "literal_string": { "color": "#00AC3A" },
      "literal_string_escape": { "color": "#00AA95" },
      "generic_deleted": { "color": "#F32E40" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#00AC3A" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#52A8FF" },
      "background": { "background_color": "#101010" }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n• "
  },
  "html_block": {
    "color": "#676767"
  },
  "html_span": {
    "color": "#676767"
  }
}
